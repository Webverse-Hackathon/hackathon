# Copy to .env and fill in. Never commit .env.

# ─── Model provider (DECISIONS.md #15) ─────────────────────────────────────────
# anthropic | openai-compatible. OpenRouter free models: 20 requests/min, 50/day (1000/day once $10 of
# credits has ever been bought). ALLY_NARRATION=decision uses one model call per step instead of two.
ALLY_LLM_PROVIDER=anthropic
ALLY_OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
ALLY_OPENAI_COMPAT_API_KEY=
ALLY_OPENAI_COMPAT_REASONING_EFFORT=low
ALLY_NARRATION=model
# NVIDIA NIM trial (DECISIONS.md #16): base https://integrate.api.nvidia.com/v1, an nvapi- key, decide and narrate
# moonshotai/kimi-k3, effort low (the model takes low, high or max), ALLY_STEP_TIMEOUT_MS=60000. About 40 requests/min per key, free, prototype use only.

# ─── Models ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional. An Anthropic-compatible gateway (e.g. a third-party router). Leave empty for the official API.
# When set, ANTHROPIC_API_KEY is that gateway's key, and the model names must be ones it serves.
# Agent Router serves Opus only: ALLY_MODEL_DECIDE=claude-opus-5, ALLY_MODEL_NARRATE=claude-opus-4-8.
ANTHROPIC_BASE_URL=
ALLY_MODEL_DECIDE=claude-sonnet-5
ALLY_MODEL_NARRATE=claude-haiku-4-5-20251001

# ─── Agent budgets ────────────────────────────────────────────────────────────
ALLY_STEP_BUDGET=20
ALLY_STEP_TIMEOUT_MS=20000
ALLY_RUN_TIMEOUT_MS=300000
ALLY_MAX_CONCURRENT_RUNS=4
ALLY_TRANSCRIPT_MAX_LINES=400
ALLY_DAILY_TOKEN_CEILING=5000000

# ─── Determinism ──────────────────────────────────────────────────────────────
# Set to a run id to replay that run from disk with no browser and no network.
# ALLY_REPLAY=
ALLY_RECORD=1
ALLY_RECORDINGS_DIR=./recordings

# ─── Data ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ally:ally@localhost:5432/ally
REDIS_URL=redis://localhost:6379

# ─── Services ─────────────────────────────────────────────────────────────────
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
FIXTURE_URL=http://localhost:3100

# ─── GitHub App (Mode A — repo-connected patching) ────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_DEFAULT_OWNER=Webverse-Hackathon

# ─── Safety ───────────────────────────────────────────────────────────────────
# Comma-separated. Leave empty to allow any public host (private ranges are
# always blocked regardless — see F-01 in docs/09-FAILURE-MODES.md).
ALLY_ALLOWED_HOSTS=
ALLY_RATE_LIMIT_BYPASS_TOKEN=

# ─── Playwright ───────────────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
