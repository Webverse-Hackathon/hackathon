{
  "name": "@ally/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel \"/^dev:(api|worker)$/\"",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "agent": "tsx src/cli/agent.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run tests/unit",
    "test:purity": "vitest run tests/unit/purity.test.ts",
    "test:integration": "vitest run tests/integration --testTimeout=180000",
    "test:e2e": "vitest run tests/e2e --testTimeout=300000",
    "prisma": "prisma"
  },
  "dependencies": {
    "@ally/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.125.0",
    "@axe-core/playwright": "^4.10.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@octokit/auth-app": "^7.1.0",
    "@octokit/rest": "^21.0.0",
    "@prisma/client": "^6.1.0",
    "axe-core": "^4.10.0",
    "bullmq": "^5.34.0",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.0",
    "ioredis": "^5.4.0",
    "pino": "^9.5.0",
    "playwright": "^1.49.0",
    "ts-morph": "^24.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
